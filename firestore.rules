rules_version = '2';
// Quy tắc phân quyền Firestore – ứng dụng QL EPC Ô Môn I
// Admin và 5 đơn vị: xem, thêm, sửa, xoá mọi dữ liệu. Lãnh đạo: chỉ xem.
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null && request.auth.token.email is string; }
    function uname()  { return request.auth.token.email.split('@')[0]; }
    function role()   { return {'admin':'admin','pkhvt':'unit','pxscc':'unit','pxscd':'unit','pxgcph':'unit','pkd':'unit','lanhdao':'leader'}.get(uname(), 'none'); }
    function member() { return authed() && role() != 'none'; }
    function editor() { return authed() && (role() == 'admin' || role() == 'unit'); }

    // Mốc chuẩn bị, tiến độ L4, cuộc họp, yêu cầu, nhật ký, tồn tại/NCR
    match /{col}/{id} {
      allow read: if member() && col in ['milestones','activities','meetings','actions','logs','issues','blobs'];
      allow write: if editor() && col in ['milestones','activities','meetings','actions','logs','issues'];
    }
    // File tải lên (lưu từng mảnh trong Firestore, tối đa 10 MB/file)
    match /blobs/{fid} {
      allow create: if editor() && request.resource.data.by == uname() && request.resource.data.size <= 10485760;
      allow delete: if editor();
      match /c/{n} {
        allow read: if member();
        allow create, delete: if editor();
      }
    }
  }
}
